@model DevService
@{
    ViewData["Title"] = $"{Model.Name} — DevDeck";
    ViewData["PageTitle"] = Model.Name;
    ViewData["Crumb"] = "Service detail";
    var runningInfo = ViewBag.RunningInfo as RunningProcessInfo;
    var recent = (ViewBag.RecentRuns as List<ServiceRun>) ?? new();
    var liveLogs = (ViewBag.LiveLogs as List<LogLine>) ?? new();
}

@section Actions {
    <a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-ghost" asp-area="Manage" asp-controller="Logs" asp-action="ServiceLogs" asp-route-id="@Model.Id">Logs</a>
}

<div class="grid-cards" style="grid-template-columns: 1fr 1fr;">
    <div class="card card-pad">
        <div class="section-title">Configuration</div>
        <dl class="kv">
            <dt>Type</dt><dd class="mono">@Model.ServiceType</dd>
            <dt>Working dir</dt><dd class="mono dim">@Model.WorkingDirectory</dd>
            <dt>Start command</dt><dd class="mono">@Model.StartCommand @Model.StartArguments</dd>
            <dt>URL</dt><dd>@(string.IsNullOrEmpty(Model.Url) ? "—" : Model.Url)</dd>
            <dt>Port</dt><dd>@(Model.Port?.ToString() ?? "—")</dd>
            <dt>Enabled</dt><dd>@(Model.Enabled ? "Yes" : "No")</dd>
            <dt>Auto-start</dt><dd>@(Model.AutoStart ? "Yes" : "No")</dd>
        </dl>
    </div>

    <div class="card card-pad">
        <div class="section-title">Runtime</div>
        @if (runningInfo is null)
        {
            <div class="empty" style="padding:18px">Not running.</div>
        }
        else
        {
            <dl class="kv">
                <dt>Status</dt><dd><span class="pill pill-running">@runningInfo.Status</span></dd>
                <dt>Started</dt><dd>@runningInfo.StartedUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                <dt>PID</dt><dd class="mono">@(SafePid(runningInfo))</dd>
                <dt>Log file</dt><dd class="mono dim">@runningInfo.LogFilePath</dd>
            </dl>
        }
    </div>
</div>

<div class="section" style="margin-top:18px">
    <div class="section-title">Recent runs</div>
    @if (recent.Count == 0)
    {
        <div class="empty">No runs yet.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="tbl">
                <thead><tr><th>Run</th><th>Started</th><th>Stopped</th><th>Status</th><th>Exit</th><th>Log</th></tr></thead>
                <tbody>
                @foreach (var r in recent)
                {
                    <tr>
                        <td><a asp-area="Manage" asp-controller="Runs" asp-action="Details" asp-route-id="@r.Id">#@r.Id</a></td>
                        <td class="dim">@r.StartedUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="dim">@(r.StoppedUtc?.LocalDateTime.ToString("HH:mm:ss") ?? "—")</td>
                        <td><span class="pill pill-@(r.Status.ToLower())">@r.Status</span></td>
                        <td class="mono">@(r.ExitCode?.ToString() ?? "—")</td>
                        <td>@if (!string.IsNullOrEmpty(r.LogFilePath)) { <a asp-area="Manage" asp-controller="Logs" asp-action="Download" asp-route-runId="@r.Id">download</a> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="section">
    <div class="section-title">Live log (last 50 lines)</div>
    <div class="log-panel">
@foreach (var l in liveLogs)
{
    <div class="log-line @l.Stream">@l.Format()</div>
}
@if (liveLogs.Count == 0) { <div class="dim">No live log yet.</div> }
    </div>
</div>

@functions {
    static int? SafePid(RunningProcessInfo info) { try { return info.Process.Id; } catch { return null; } }
}
