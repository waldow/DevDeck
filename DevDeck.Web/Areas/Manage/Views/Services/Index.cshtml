@model List<DevService>
@{
    ViewData["Title"] = "Services — DevDeck";
    ViewData["PageTitle"] = "Services";
    ViewData["Crumb"] = "Configured services";
    var presets = (ViewBag.Presets as IReadOnlyList<CommandPreset>) ?? new List<CommandPreset>();
    var running = (ViewBag.RunningIds as HashSet<int>) ?? new HashSet<int>();
    var conflictPorts = (ViewBag.ConflictPorts as HashSet<int>) ?? new HashSet<int>();
    var pollMs = ViewBag.PollMs as int? ?? 1500;
}

@section Actions {
    <a class="btn btn-primary" asp-action="Create">+ New service</a>
}

@await Html.PartialAsync("_ImportExportToolbar", new DevDeck.Web.Areas.Manage.ViewModels.ImportExportToolbarModel
{
    ControllerName = "Services",
    EntityLabelSingular = "service",
    EntityLabelPlural = "services",
    SupportsIncludeSecrets = true,
})

<section class="section">
    <div class="section-title">Quick add from preset</div>
    <div class="preset-grid">
        @foreach (var p in presets)
        {
            <a class="preset-card" asp-action="Create" asp-route-preset="@p.Key">
                <div class="preset-mark">@p.Key</div>
                <div class="preset-name">@p.DisplayName</div>
            </a>
        }
    </div>
</section>

@if (Model.Count == 0)
{
    <div class="empty">No services yet — pick a preset above to start.</div>
}
else
{
    <div class="table-wrap" id="svc-table" data-poll="@pollMs">
        <table class="tbl">
            <thead>
                <tr><th>Name</th><th>Type</th><th>Working dir</th><th>Port</th><th>Status</th><th class="cell-actions">Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                var isRunning = running.Contains(s.Id);
                var isExternal = s.UseExternalInstance;
                var hasHealth = s.HealthChecks.Any(h => h.Enabled);
                var healthText = (isRunning || isExternal) ? "Unknown" : "NotRunning";
                var runtimeText = isExternal ? "External" : (isRunning ? "Running" : "Stopped");
                var portConflict = s.Port is int prt && conflictPorts.Contains(prt);
                <tr class="svc-row" data-service-id="@s.Id" data-enabled="@s.Enabled.ToString().ToLowerInvariant()" data-external="@isExternal.ToString().ToLowerInvariant()">
                    <td>
                        <div class="status-cell">
                            <a asp-action="Details" asp-route-id="@s.Id"><strong>@s.Name</strong></a>
                            @if (!s.Enabled) { <span class="pill pill-stopped">disabled</span> }
                            @if (s.AutoStart) { <span class="pill pill-info">auto</span> }
                            @if (isExternal) { <span class="pill pill-tag" title="DevDeck proxies to an instance you run yourself">passthru</span> }
                        </div>
                    </td>
                    <td class="mono">@s.ServiceType</td>
                    <td class="mono dim" title="@s.WorkingDirectory">@System.IO.Path.GetFileName(s.WorkingDirectory.TrimEnd('/', '\\'))</td>
                    <td class="mono">
                        @(s.EffectivePort?.ToString() ?? "—")
                        @if (portConflict)
                        {
                            <span class="port-conflict" title="Port @s.Port is in use by another process">in use</span>
                        }
                    </td>
                    <td>
                        <div class="status-cell">
                            <span class="pill pill-@(runtimeText.ToLower())" data-field="runtime">@runtimeText</span>
                            @if (hasHealth)
                            {
                                <span class="pill pill-@(healthText.ToLower())" data-field="health">@healthText</span>
                            }
                        </div>
                    </td>
                    <td>
                        <div class="btn-row">
                            <div class="row-actions" data-when="running" @(isRunning && !isExternal ? null : "hidden")>
                                <form class="inline" method="post" asp-action="Stop" asp-route-id="@s.Id">@Html.AntiForgeryToken()<button class="btn btn-warn" type="submit">Stop</button></form>
                                <form class="inline" method="post" asp-action="Restart" asp-route-id="@s.Id">@Html.AntiForgeryToken()<button class="btn" type="submit">Restart</button></form>
                            </div>
                            <div class="row-actions" data-when="stopped" @(!isRunning && !isExternal ? null : "hidden")>
                                <form class="inline" method="post" asp-action="Start" asp-route-id="@s.Id">@Html.AntiForgeryToken()<button class="btn btn-ok" type="submit">Start</button></form>
                            </div>
                            <div class="row-actions">
                                <form class="inline js-toggle-external" method="post" asp-action="ToggleExternal" asp-route-id="@s.Id">@Html.AntiForgeryToken()<button class="btn btn-ghost" type="submit" title="Switch between DevDeck-managed and an external (passthru) instance">@(isExternal ? "Manage here" : "Use external")</button></form>
                                <a class="btn" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                                <a class="btn btn-ghost" asp-area="Manage" asp-controller="Logs" asp-action="ServiceLogs" asp-route-id="@s.Id">Logs</a>
                                <a class="btn btn-ghost" asp-action="ExportOne" asp-route-id="@s.Id" title="Download this service as JSON">Export</a>
                                <form class="inline" method="post" asp-action="Delete" asp-route-id="@s.Id" onsubmit="return confirm('Delete this service?');">@Html.AntiForgeryToken()<button class="btn btn-danger" type="submit">Delete</button></form>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/services.js" asp-append-version="true"></script>
}
