@model ServiceEditViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = (isNew ? "New service" : "Edit service") + " — DevDeck";
    ViewData["PageTitle"] = isNew ? "New service" : $"Edit: {Model.Name}";
    ViewData["Crumb"] = "Services";
    var presets = (ViewBag.Presets as IReadOnlyList<CommandPreset>) ?? new List<CommandPreset>();
    var isRunning = ViewBag.IsRunning as bool? == true;
    var portWarning = ViewBag.PortWarning as string;
}

@if (isRunning)
{
    <div class="flash info">This service is currently running. Changes will apply after restart.</div>
}
@if (!string.IsNullOrEmpty(portWarning))
{
    <div class="flash error">@portWarning</div>
}

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <div class="card card-pad">
        <div class="form-grid">
            <label for="Name">Name</label>
            <div class="form-row">
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <label for="ServiceType">Type</label>
            <div class="form-row">
                <select asp-for="ServiceType">
                    @foreach (var p in presets) { <option value="@p.Key">@p.DisplayName</option> }
                </select>
            </div>

            <label for="WorkingDirectory">Working directory</label>
            <div class="form-row">
                <input asp-for="WorkingDirectory" class="mono" placeholder="/path/to/project or C:\path\to\project" />
                <span asp-validation-for="WorkingDirectory" class="field-validation-error"></span>
                <span class="hint">Absolute path. Must exist when the service is started.</span>
            </div>

            <label for="StartCommand">Start command</label>
            <div class="form-row">
                <input asp-for="StartCommand" class="mono" />
                <span class="hint">Executable name (will resolve <span class="k">npm</span>/<span class="k">npm.cmd</span> per OS) or absolute path.</span>
            </div>

            <label for="StartArguments">Start arguments</label>
            <div class="form-row">
                <input asp-for="StartArguments" class="mono" />
                <span class="hint">Placeholders: <span class="k">{port}</span> <span class="k">{name}</span> <span class="k">{id}</span> <span class="k">{workingDirectory}</span></span>
            </div>

            <label for="Port">Port</label>
            <div class="form-row"><input asp-for="Port" type="number" /></div>

            <label for="Url">URL</label>
            <div class="form-row">
                <input asp-for="Url" class="mono" placeholder="http://localhost:{port}" />
                <span class="url-preview" id="urlPreview" hidden></span>
            </div>

            <label></label>
            <div class="form-row inline-checks">
                <label><input asp-for="Enabled" type="checkbox" /> Enabled</label>
                <label><input asp-for="AutoStart" type="checkbox" /> Auto-start with DevDeck</label>
            </div>

            <label for="DisplayOrder">Display order</label>
            <div class="form-row"><input asp-for="DisplayOrder" type="number" /></div>
        </div>
    </div>

    <div class="card section mt-md">
        <div class="card-head"><h2>Environment variables</h2></div>
        <div class="card-pad">
            <table class="tbl" id="envvars">
                <thead><tr><th>Key</th><th>Value</th><th>Secret</th><th class="cell-actions"></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.EnvironmentVariables.Count; i++)
                    {
                        var prefix = $"EnvironmentVariables[{i}]";
                        <tr class="repeat-row">
                            <td><input name="@(prefix).Id" type="hidden" value="@Model.EnvironmentVariables[i].Id" /><input name="@(prefix).Key" value="@Model.EnvironmentVariables[i].Key" class="mono" /></td>
                            <td class="cell-value">
                                <input name="@(prefix).Value" value="@Model.EnvironmentVariables[i].Value" class="mono js-value" type="@(Model.EnvironmentVariables[i].IsSecret ? "password" : "text")" autocomplete="off" />
                                <button type="button" class="icon-btn reveal js-reveal" title="Show / hide value" aria-label="Show value">👁</button>
                            </td>
                            <td><input name="@(prefix).IsSecret" type="checkbox" value="true" @(Model.EnvironmentVariables[i].IsSecret ? "checked" : "")><input name="@(prefix).IsSecret" type="hidden" value="false" /></td>
                            <td class="cell-actions">
                                <input name="@(prefix).Delete" type="hidden" value="false" class="js-delete-flag" />
                                <button type="button" class="icon-btn danger js-remove" title="Remove variable" aria-label="Remove variable">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn mt-md" id="addEnv">+ Add variable</button>
        </div>
    </div>

    <div class="card section mt-md">
        <div class="card-head"><h2>Health checks</h2></div>
        <div class="card-pad">
            <table class="tbl" id="healthchecks">
                <thead><tr><th>URL</th><th>Expected code</th><th>Interval (s)</th><th>Enabled</th><th class="cell-actions"></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.HealthChecks.Count; i++)
                    {
                        var prefix = $"HealthChecks[{i}]";
                        <tr class="repeat-row">
                            <td><input name="@(prefix).Id" type="hidden" value="@Model.HealthChecks[i].Id" /><input name="@(prefix).Url" value="@Model.HealthChecks[i].Url" class="mono" /></td>
                            <td><input name="@(prefix).ExpectedStatusCode" value="@Model.HealthChecks[i].ExpectedStatusCode" type="number" /></td>
                            <td><input name="@(prefix).IntervalSeconds" value="@Model.HealthChecks[i].IntervalSeconds" type="number" /></td>
                            <td><input name="@(prefix).Enabled" type="checkbox" value="true" @(Model.HealthChecks[i].Enabled ? "checked" : "")><input name="@(prefix).Enabled" type="hidden" value="false" /></td>
                            <td class="cell-actions">
                                <input name="@(prefix).Delete" type="hidden" value="false" class="js-delete-flag" />
                                <button type="button" class="icon-btn danger js-remove" title="Remove health check" aria-label="Remove health check">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn mt-md" id="addHc">+ Add health check</button>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">@(isNew ? "Create service" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/service-edit.js" asp-append-version="true"></script>
}
