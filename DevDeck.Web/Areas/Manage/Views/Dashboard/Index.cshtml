@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard — DevDeck";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["Crumb"] = "Stack overview";
}

@section Actions {
    <form class="inline" id="start-all-form" method="post" asp-area="Manage" asp-controller="Services" asp-action="StartAll">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary" id="start-all-btn"><span class="sa-label">▶&nbsp;Start all</span></button>
    </form>
    <form class="inline" id="stop-all-form" method="post" asp-area="Manage" asp-controller="Services" asp-action="StopAll">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-warn" id="stop-all-btn"><span class="sa-label">■&nbsp;Stop all</span></button>
    </form>
    <a class="btn btn-primary" asp-area="Manage" asp-controller="Services" asp-action="Create">+ New service</a>
}

@if (Model.Cards.Count == 0)
{
    <div class="empty">
        <p>No services configured yet.</p>
        <a class="btn btn-primary" asp-area="Manage" asp-controller="Services" asp-action="Create">Create your first service</a>
    </div>
}
else
{
    <div class="grid-cards" id="cards" data-poll="@Model.PollingMilliseconds">
        @foreach (var card in Model.Cards)
        {
            <div class="card service-card" data-service-id="@card.Id" data-enabled="@card.Enabled.ToString().ToLowerInvariant()">
                <div class="sc-head">
                    <div>
                        <div class="sc-name">@card.Name</div>
                        <div class="sc-type">@card.ServiceType</div>
                    </div>
                    <span class="pill pill-@(card.RuntimeStatus.ToLower())" data-field="runtime">@card.RuntimeStatus</span>
                </div>
                <div class="sc-row">
                    <span class="label">Health</span>
                    <span class="pill pill-@(card.HealthStatus.ToLower())" data-field="health">@card.HealthStatus</span>
                    @if (card.Port is int p)
                    {
                        <span class="label" style="margin-left:auto">Port</span>
                        <span class="k">@p</span>
                    }
                </div>
                <div class="sc-links">
                    @if (!string.IsNullOrEmpty(card.Url))
                    {
                        <a class="btn" href="@card.Url" target="_blank" rel="noopener">Open direct</a>
                    }
                    @if (!string.IsNullOrEmpty(card.ProxyUrl))
                    {
                        <a class="btn" href="@card.ProxyUrl" target="_blank" rel="noopener">Open proxy</a>
                    }
                    <a class="btn btn-ghost" asp-area="Manage" asp-controller="Logs" asp-action="ServiceLogs" asp-route-id="@card.Id">Logs</a>
                </div>
                <div class="sc-actions">
                    <form class="inline" method="post" asp-area="Manage" asp-controller="Services" asp-action="Start" asp-route-id="@card.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-ok" type="submit">Start</button>
                    </form>
                    <form class="inline" method="post" asp-area="Manage" asp-controller="Services" asp-action="Restart" asp-route-id="@card.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn" type="submit">Restart</button>
                    </form>
                    <form class="inline" method="post" asp-area="Manage" asp-controller="Services" asp-action="Stop" asp-route-id="@card.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-warn" type="submit">Stop</button>
                    </form>
                    <a class="btn btn-ghost" asp-area="Manage" asp-controller="Services" asp-action="Details" asp-route-id="@card.Id">Details</a>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/start-all.js" asp-append-version="true"></script>
    <script src="~/js/stop-all.js" asp-append-version="true"></script>
}
